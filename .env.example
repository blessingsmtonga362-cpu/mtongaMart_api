# PayChangu Direct Charge (keep secret values in the backend environment only)
APP_PORT=3000
# Customer-facing web/app entry point. Use your production HTTPS frontend URL in live hosting.
APP_URL=http://localhost:3000
# Public API origin used by links that need to reach this NestJS server.
API_PUBLIC_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_local_postgres_user
DB_PASSWORD=your_local_postgres_password
DB_DATABASE=mtongamart

PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_AIRTEL_OPERATOR_REF_ID=20be6c20-adeb-4b5b-a7ba-0769820df4fb
PAYCHANGU_TNM_OPERATOR_REF_ID=27494cb5-ba9e-437f-a114-4e7a7686bcca

# Keep TypeORM schema synchronization off unless preparing a local schema.
DB_SYNCHRONIZE=false

# Receipt PDFs are stored on local disk by default; use a persistent volume in production.
RECEIPT_STORAGE_DIR=storage/receipts

# SMTP settings. Use provider-issued credentials in the host's secret manager.
SMTP_HOST=localhost
SMTP_PORT=587
# Set true for implicit TLS (usually port 465); false for STARTTLS (usually port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MtongaMart
SMTP_FROM_EMAIL=

# Generate a unique secret for each environment; never use this example value in production.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
